# =========================================================================
# CyberEval - Environment Configuration
# =========================================================================

# Security
CYBEREVAL_SECRET_KEY=generate_with_openssl_rand_hex_32

# Database Configuration (Defaults to local SQLite with WAL mode)
# For production PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/cybereval
DATABASE_URL=sqlite+aiosqlite:///cybereval.db

# Host & Port Settings
HOST=127.0.0.1
PORT=8000

# Model Provider API Keys (Optional; Built-in baseline expert & flawed mock models work offline out of the box)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
